<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FlatTree</RootNamespace>
    <AssemblyName>FlatTree</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
